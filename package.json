{
  "name": "project-reader",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Client-only viewer for .jsonl session transcripts",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "check": "tsc --noEmit",
    "test": "node --import ./test/ts-resolve.mjs --test \"test/**/*.test.mjs\"",
    "inspect": "node tools/inspect.mjs",
    "fixture": "node tools/gen-fixture.mjs"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "vite": "^7.1.7"
  }
}
